<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer Age Group Configuration Form View -->
    <record id="view_customer_age_group_config_form" model="ir.ui.view">
        <field name="name">Customer Age Group Configuration Form</field>
        <field name="model">smart_engagement.customer_age_group_config</field>
        <field name="arch" type="xml">
            <form string="Customer Age Group Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="group_code" placeholder="Age Group Code (e.g., YOUTH, ADULT, SENIOR)" required="1" />
                        </h1>
                        <h2>
                            <field name="display_name" placeholder="Age Group Display Name (e.g., Young Adult, Mature Professional)" required="1" />
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Age Range (Years)">
                            <field name="min_age" />
                            <field name="max_age" placeholder="Leave empty for no upper limit" />
                            <field name="sequence" />
                        </group>
                        <group string="Configuration">
                            <field name="active" />
                            <field name="group_color" widget="color" />
                        </group>
                    </group>
                    
                    <group string="Age Group Analytics">
                        <group>
                            <field name="customer_count" readonly="1" />
                            <field name="average_age" readonly="1" />
                            <field name="age_distribution_percentage" readonly="1" />
                        </group>
                        <group>
                            <field name="total_group_revenue" widget="monetary" readonly="1" />
                            <field name="average_spending" widget="monetary" readonly="1" />
                        </group>
                    </group>
                    
                    <field name="group_description" 
                           placeholder="Describe this age group - its characteristics, preferences, and business value..." />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Customer Age Group Configuration List View -->
    <record id="view_customer_age_group_config_list" model="ir.ui.view">
        <field name="name">Customer Age Group Configuration List</field>
        <field name="model">smart_engagement.customer_age_group_config</field>
        <field name="arch" type="xml">
            <list string="Customer Age Groups" 
                  default_order="sequence, min_age asc"
                  create="true"
                  edit="false"
                  delete="true"
                  decoration-muted="not active">
                <field name="sequence" widget="handle" />
                <field name="group_code" />
                <field name="display_name" />
                <field name="min_age" />
                <field name="max_age" />
                <field name="customer_count" readonly="1" />
                <field name="average_age" readonly="1" />
                <field name="age_distribution_percentage" readonly="1" />
                <field name="group_color" widget="color" optional="hide" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- Customer Age Group Configuration Search View -->
    <record id="view_customer_age_group_config_search" model="ir.ui.view">
        <field name="name">Customer Age Group Configuration Search</field>
        <field name="model">smart_engagement.customer_age_group_config</field>
        <field name="arch" type="xml">
            <search string="Search Customer Age Groups">
                <field name="group_code" />
                <field name="display_name" />
                <field name="min_age" />
                <field name="max_age" />
                
                <filter string="Active Groups" 
                        name="active_groups" 
                        domain="[('active', '=', True)]" />
                <filter string="Inactive Groups" 
                        name="inactive_groups" 
                        domain="[('active', '=', False)]" />
                
                
                <group expand="0" string="Group By">
                    <filter string="Active Status" 
                            name="group_by_active" 
                            context="{'group_by': 'active'}" />
                    <filter string="Age Range" 
                            name="group_by_age_range" 
                            context="{'group_by': 'min_age'}" />
                </group>
            </search>
        </field>
    </record>

    <!-- Customer Age Group Configuration Action -->
    <record id="action_customer_age_group_config" model="ir.actions.act_window">
        <field name="name">Customer Age Group Configuration</field>
        <field name="res_model">smart_engagement.customer_age_group_config</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_customer_age_group_config_list" />
        <field name="search_view_id" ref="view_customer_age_group_config_search" />
        <field name="context">{'search_default_active_groups': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first customer age group!
            </p>
            <p>
                Configure age-based customer segments to understand demographics and tailor marketing strategies.
                These age groups will be used throughout analytics and reporting to provide demographic insights.
            </p>
            <p>
                <strong>Getting Started:</strong>
                <ul>
                    <li>Create age groups like Youth (18-25), Adult (26-45), Senior (65+), etc.</li>
                    <li>Set minimum and maximum ages for each group</li>
                    <li>Use these groups for demographic analysis and targeted campaigns</li>
                    <li>Monitor age group analytics to understand customer demographics</li>
                    <li>Leave maximum age empty for open-ended groups (e.g., "65 and above")</li>
                </ul>
            </p>
        </field>
    </record>

</odoo>