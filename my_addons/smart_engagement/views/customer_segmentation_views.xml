<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="smart_engagement_customer_segmentation_action" model="ir.actions.act_window">
        <field name="name">Customer Segmentation</field>
        <field name="res_model">smart_engagement.customer_segmentation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Segment your customers to create targeted campaigns.
            </p>
        </field>
    </record>

    <record id="smart_engagement_customer_segmentation_list_view" model="ir.ui.view">
        <field name="name">smart_engagement.customer_segmentation.list</field>
        <field name="model">smart_engagement.customer_segmentation</field>
        <field name="arch" type="xml">
            <list string="Customer Segmentation">
                <field name="name" />
                <field name="description" optional="show" />
                <field name="type" />
            </list>
        </field>
    </record>

    <record id="smart_engagement_customer_segmentation_form_view" model="ir.ui.view">
        <field name="name">smart_engagement.customer_segmentation.form</field>
        <field name="model">smart_engagement.customer_segmentation</field>
        <field name="arch" type="xml">
            <form string="Customer Segmentation">
                <sheet>
                    <group>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name.." />
                            </h1>
                        </div>
                        <field name="description" />
                        <field name="type" widget="radio"
                            options="{'horizontal': true}" />
                        <field name="selected_customers"
                            domain="['|', ('phone', '!=', False), ('mobile', '!=', False)]"
                            invisible="type != 'manual'"
                            required="type == 'manual'" />
                        <field name="rules" widget="domain"
                            options="{'model': 'res.partner', 'foldable': true}"
                            invisible="type != 'rules'"
                            required="type == 'rules'" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
</odoo>