<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="smart_engagement_campaign_action" model="ir.actions.act_window">
        <field name="name">Campaign</field>
        <field name="res_model">smart_engagement.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Campaign to start your WhatsApp marketing automation journey.
            </p>
        </field>
    </record>

    <record id="smart_engagement_campaign_list_view" model="ir.ui.view">
        <field name="name">smart_engagement.campaign.list</field>
        <field name="model">smart_engagement.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaign">
                <field name="name" />
                <field name="type" optional="show" />
                <field name="customer_segmentation_id" optional="show" />
                <field name="state" optional="show" />
            </list>
        </field>
    </record>


    <record id="smart_engagement_campaign_form_view" model="ir.ui.view">
        <field name="name">smart_engagement.campaign.form</field>
        <field name="model">smart_engagement.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <header>

                    <button name="action_run" type="object" string="Run" class="oe_highlight"
                        invisible="not state == 'draft'" />
                    <button name="action_test" type="object" string="Test"
                        invisible="not state == 'draft'"
                        help="This will send the message template to the test customer in the configuration. If none is set, it will use the first matching customer." />
                    <button name="action_preview_messages" type="object" string="Preview Message"
                        invisible="not state == 'draft'" />
                    <button name="action_finish" type="object" string="Finish" class="oe_highlight"
                        invisible="not state == 'running'" />
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="not state == 'running'" />
                    <button name="action_reset" type="object" string="Reset" class="oe_highlight"
                        invisible="state == 'draft' or state == 'running'" />
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,running,finished" />
                </header>
                <sheet>
                    <group>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Name.." readonly="state != 'draft'" />
                            </h1>
                        </div>
                        <field name="type" widget="radio" options="{'horizontal': true}"
                            readonly="state != 'draft'" />
                        <field name="end_date" invisible="type != 'time_based'"
                            required="type == 'time_based'" readonly="state != 'draft'" />
                        <field name="customer_segmentation_id" readonly="state != 'draft'" />
                        <field name="assigned_to" domain="[('is_company', '=', False)]"
                            readonly="state != 'draft'" />
                    </group>
                    <br />
                    <notebook>
                        <page string="Message Configuration">
                            <group>
                                <group string="Initial Message Configuration">
                                    <field name="message_template" readonly="state != 'draft'" />
                                    <field name="message_initial_send_type" widget="radio"
                                        options="{'horizontal': true}"
                                        readonly="state != 'draft'" />
                                    <field name="message_initial_send_specific_date"
                                        invisible="message_initial_send_type != 'specific_date'"
                                        required="message_initial_send_type == 'specific_date'"
                                        readonly="state != 'draft'" />
                                    <field name="message_initial_send_after_x_minutes"
                                        invisible="message_initial_send_type != 'after_x_minutes'"
                                        required="message_initial_send_type == 'after_x_minutes'"
                                        readonly="state != 'draft'" />
                                    <field name="message_initial_send_after_x_hours"
                                        invisible="message_initial_send_type != 'after_x_hours'"
                                        required="message_initial_send_type == 'after_x_hours'"
                                        readonly="state != 'draft'" />
                                    <field name="message_initial_send_after_x_days"
                                        invisible="message_initial_send_type != 'after_x_days'"
                                        required="message_initial_send_type == 'after_x_days'"
                                        readonly="state != 'draft'" />
                                </group>
                                <group string="Product Recommendation Configuration">
                                    <field name="product_recommendation_type" widget="radio"
                                        options="{'horizontal': true}" readonly="state != 'draft'" />
                                    <field name="product_recommendation_fixed_products"
                                        invisible="product_recommendation_type != 'fixed_products'"
                                        required="product_recommendation_type == 'fixed_products'"
                                        readonly="state != 'draft'" />
                                    <field name="product_recommendation_rules"
                                        widget="domain"
                                        options="{'model': 'product.product', 'foldable': true}"
                                        invisible="product_recommendation_type != 'rules'"
                                        required="product_recommendation_type == 'rules'"
                                        readonly="state != 'draft'" />
                                </group>
                            </group>
                            <separator string="Recurring Message Configuration" />
                            <group>
                                <group>
                                    <field name="message_should_send_repeat"
                                        widget="boolean_toggle"
                                        readonly="state != 'draft'" />
                                    <field name="message_send_repeat_trigger_type" widget="radio"
                                        options="{'horizontal': true}"
                                        invisible="not message_should_send_repeat"
                                        readonly="state != 'draft'" />
                                    <field name="message_send_repeat_trigger_days"
                                        invisible="not message_should_send_repeat or message_send_repeat_trigger_type != 'every_x_days'"
                                        required="message_should_send_repeat and message_send_repeat_trigger_type == 'every_x_days'"
                                        readonly="state != 'draft'" />
                                    <field name="message_send_repeat_trigger_weeks"
                                        invisible="not message_should_send_repeat or message_send_repeat_trigger_type != 'every_x_weeks'"
                                        required="message_should_send_repeat and message_send_repeat_trigger_type == 'every_x_weeks'"
                                        readonly="state != 'draft'" />
                                    <field name="message_send_repeat_trigger_time"
                                        widget="float_time"
                                        min="0.0"
                                        max="23.59"
                                        invisible="not message_should_send_repeat"
                                        required="message_should_send_repeat"
                                        readonly="state != 'draft'" />
                                </group>
                                <group>
                                    <!-- Empty group for balance -->
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

</odoo>