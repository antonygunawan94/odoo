<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cleanup cron job for deactivating completed one-time jobs (initial messages and
        auto-finish) -->
        <record id="ir_cron_cleanup_completed_campaign_jobs" model="ir.cron">
            <field name="name">WA Marketing: Cleanup Completed Campaign Jobs (Initial &amp;
                Auto-Finish)</field>
            <field name="model_id"
                ref="smart_engagement.model_smart_engagement_campaign" />
            <field name="state">code</field>
            <field name="code">model._cleanup_completed_campaign_jobs()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority">1000</field>
            <field name="active" eval="True" />
            <field name="user_id" ref="base.user_root" />
        </record>
    </data>
</odoo> 