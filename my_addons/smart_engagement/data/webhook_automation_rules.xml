<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Contact Data Webhook Automation Rule -->
        <record id="automation_webhook_contact_sync" model="base.automation">
            <field name="name">Webhook: Contact Smart Sync</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="trigger">on_webhook</field>
            <field name="record_getter">model.search([], limit=1)</field>
            <field name="active">True</field>
            <field name="log_webhook_calls">True</field>
            <field name="action_server_ids"
                eval="[(4, ref('smart_engagement.action_webhook_contact_smart_sync'))]" />
        </record>

