<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Create default age groups if none exist (prevents XML validation conflicts) -->
        <function model="wa_marketing_automation.customer_age_group_config" name="create_default_age_groups_if_empty" />
        
        <!-- Force computation of analytics fields for all existing customers -->
        <function model="res.partner" name="_force_analytics_computation">
            <value model="res.partner" search="[('customer_rank', '>', 0)]"/>
        </function>
    </data>
</odoo>