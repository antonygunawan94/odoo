<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Customer Spending Tiers - Generic Business Values -->
        
        <!-- VIP Tier -->
        <record id="spending_tier_vip" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">vip</field>
            <field name="display_name">VIP</field>
            <field name="min_spending_amount">10000.0</field>
            <field name="max_spending_amount" eval="False"/>
            <field name="sequence">1</field>
            <field name="tier_color">#9c27b0</field>
            <field name="tier_description">Top-tier customers with highest lifetime value and spending</field>
        </record>
        
        <!-- Premium Tier -->
        <record id="spending_tier_premium" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">premium</field>
            <field name="display_name">Premium</field>
            <field name="min_spending_amount">5000.0</field>
            <field name="max_spending_amount">9999.99</field>
            <field name="sequence">2</field>
            <field name="tier_color">#2196f3</field>
            <field name="tier_description">High-value customers with strong purchasing power</field>
        </record>
        
        <!-- Gold Tier -->
        <record id="spending_tier_gold" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">gold</field>
            <field name="display_name">Gold</field>
            <field name="min_spending_amount">2500.0</field>
            <field name="max_spending_amount">4999.99</field>
            <field name="sequence">3</field>
            <field name="tier_color">#ffc107</field>
            <field name="tier_description">Loyal customers with consistent spending patterns</field>
        </record>
        
        <!-- Silver Tier -->
        <record id="spending_tier_silver" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">silver</field>
            <field name="display_name">Silver</field>
            <field name="min_spending_amount">1000.0</field>
            <field name="max_spending_amount">2499.99</field>
            <field name="sequence">4</field>
            <field name="tier_color">#607d8b</field>
            <field name="tier_description">Regular customers with moderate purchasing activity</field>
        </record>
        
        <!-- Bronze Tier -->
        <record id="spending_tier_bronze" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">bronze</field>
            <field name="display_name">Bronze</field>
            <field name="min_spending_amount">500.0</field>
            <field name="max_spending_amount">999.99</field>
            <field name="sequence">5</field>
            <field name="tier_color">#ff6f00</field>
            <field name="tier_description">Active customers with growing engagement</field>
        </record>
        
        <!-- Standard Tier -->
        <record id="spending_tier_standard" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">standard</field>
            <field name="display_name">Standard</field>
            <field name="min_spending_amount">200.0</field>
            <field name="max_spending_amount">499.99</field>
            <field name="sequence">6</field>
            <field name="tier_color">#4caf50</field>
            <field name="tier_description">Established customers with standard purchasing behavior</field>
        </record>
        
        <!-- Basic Tier -->
        <record id="spending_tier_basic" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">basic</field>
            <field name="display_name">Basic</field>
            <field name="min_spending_amount">50.0</field>
            <field name="max_spending_amount">199.99</field>
            <field name="sequence">7</field>
            <field name="tier_color">#00bcd4</field>
            <field name="tier_description">New or occasional customers with limited purchase history</field>
        </record>
        
        <!-- Entry Tier -->
        <record id="spending_tier_entry" model="wa_marketing_automation.customer_spending_tier_config">
            <field name="tier_code">entry</field>
            <field name="display_name">Entry</field>
            <field name="min_spending_amount">0.0</field>
            <field name="max_spending_amount">49.99</field>
            <field name="sequence">8</field>
            <field name="tier_color">#9e9e9e</field>
            <field name="tier_description">New customers or prospects with minimal purchase activity</field>
        </record>
        
    </data>
</odoo>