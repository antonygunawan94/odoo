<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Customer Acquisition Sources -->
        
        <!-- Social Media -->
        <record id="acquisition_source_social_media" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Social Media</field>
            <field name="display_name">Social Media Marketing</field>
            <field name="code">social_media</field>
            <field name="description">Customer acquired through social media platforms (Facebook, Instagram, Twitter, TikTok, LinkedIn, etc.)</field>
            <field name="sequence">10</field>
            <field name="is_digital">True</field>
            <field name="is_social">True</field>
            <field name="icon">fa-share-alt</field>
            <field name="color">1</field>
        </record>
        
        <!-- Search Engine -->
        <record id="acquisition_source_search_engine" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Search Engine</field>
            <field name="display_name">Search Engine (SEO/SEM)</field>
            <field name="code">search_engine</field>
            <field name="description">Customer acquired through search engines (Google, Bing, Yahoo, etc.) via organic search or paid ads</field>
            <field name="sequence">20</field>
            <field name="is_digital">True</field>
            <field name="is_social">False</field>
            <field name="icon">fa-search</field>
            <field name="color">2</field>
        </record>
        
        <!-- Website -->
        <record id="acquisition_source_website" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Website</field>
            <field name="display_name">Direct Website Visit</field>
            <field name="code">website</field>
            <field name="description">Customer came directly to the website by typing URL or using bookmarks</field>
            <field name="sequence">30</field>
            <field name="is_digital">True</field>
            <field name="is_social">False</field>
            <field name="icon">fa-globe</field>
            <field name="color">3</field>
        </record>
        
        <!-- Email Campaign -->
        <record id="acquisition_source_email" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Email Campaign</field>
            <field name="display_name">Email Marketing Campaign</field>
            <field name="code">email_campaign</field>
            <field name="description">Customer acquired through email marketing campaigns, newsletters, or promotional emails</field>
            <field name="sequence">40</field>
            <field name="is_digital">True</field>
            <field name="is_social">False</field>
            <field name="icon">fa-envelope</field>
            <field name="color">4</field>
        </record>
        
        <!-- Referral -->
        <record id="acquisition_source_referral" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Friend/Family Referral</field>
            <field name="display_name">Friend or Family Referral</field>
            <field name="code">referral</field>
            <field name="description">Customer referred by existing customers, friends, or family members</field>
            <field name="sequence">50</field>
            <field name="is_digital">False</field>
            <field name="is_social">False</field>
            <field name="icon">fa-users</field>
            <field name="color">5</field>
        </record>
        
        <!-- Walk-in/Direct -->
        <record id="acquisition_source_walkin" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Walk-in/Direct</field>
            <field name="display_name">Walk-in or Direct Visit</field>
            <field name="code">walkin</field>
            <field name="description">Customer walked into physical store or office without prior contact</field>
            <field name="sequence">60</field>
            <field name="is_digital">False</field>
            <field name="is_social">False</field>
            <field name="icon">fa-store</field>
            <field name="color">6</field>
        </record>
        
        <!-- Partner/Affiliate -->
        <record id="acquisition_source_partner" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Partner/Affiliate</field>
            <field name="display_name">Partner or Affiliate Program</field>
            <field name="code">partner</field>
            <field name="description">Customer acquired through business partners, affiliates, or referral programs</field>
            <field name="sequence">70</field>
            <field name="is_digital">False</field>
            <field name="is_social">False</field>
            <field name="icon">fa-handshake</field>
            <field name="color">7</field>
        </record>
        
        <!-- Event/Trade Show -->
        <record id="acquisition_source_event" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Event/Trade Show</field>
            <field name="display_name">Event or Trade Show</field>
            <field name="code">event</field>
            <field name="description">Customer met at events, trade shows, conferences, or exhibitions</field>
            <field name="sequence">80</field>
            <field name="is_digital">False</field>
            <field name="is_social">False</field>
            <field name="icon">fa-calendar-check</field>
            <field name="color">8</field>
        </record>
        
        <!-- Other -->
        <record id="acquisition_source_other" model="wa_marketing_automation.customer_acquisition_source_config">
            <field name="name">Other</field>
            <field name="display_name">Other Source</field>
            <field name="code">other</field>
            <field name="description">Customer acquired through other sources not listed above</field>
            <field name="sequence">90</field>
            <field name="is_digital">False</field>
            <field name="is_social">False</field>
            <field name="icon">fa-question-circle</field>
            <field name="color">9</field>
        </record>
        
    </data>
</odoo>