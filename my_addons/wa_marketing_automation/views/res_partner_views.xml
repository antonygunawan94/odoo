<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Form View - Add Date of Birth, Age, and RFM fields -->
    <record id="view_partner_form_dob" model="ir.ui.view">
        <field name="name">res.partner.form.dob</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field name="date_of_birth" invisible="is_company" />
                <field name="age_display" invisible="is_company or not date_of_birth" />
            </field>
        </field>
    </record>

    <!-- Partner Form View - Add Advanced Analytics Pages -->
    <record id="view_partner_form_advanced_analytics" model="ir.ui.view">
        <field name="name">res.partner.form.advanced.analytics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales_purchases']" position="after">
                <!-- Advanced Analytics Tab with Sub-tabs -->
                <page name="advanced_analytics" string="Analytics" invisible="is_company">
                    <!-- Configuration visibility fields (invisible, used for conditional visibility) -->
                    <field name="metrics_engagement_enabled" invisible="1"/>
                    <field name="metrics_churn_enabled" invisible="1"/>
                    <field name="metrics_journey_enabled" invisible="1"/>
                    <field name="metrics_values_enabled" invisible="1"/>
                    <field name="metrics_social_enabled" invisible="1"/>
                    <field name="metrics_bnpl_enabled" invisible="1"/>
                    <field name="metrics_mobile_enabled" invisible="1"/>
                    <field name="metrics_multichannel_enabled" invisible="1"/>
                    <notebook>
                        <!-- RFM Analysis Sub-tab -->
                        <page name="rfm_analysis" string="RFM Analysis"
                            invisible="not customer_rank">
                            <group name="rfm_overview">
                                <group name="rfm_scores" string="RFM Scores">
                                    <field name="rfm_segment" widget="badge"
                                        decoration-success="rfm_segment in ('champions', 'loyal_customers')"
                                        decoration-warning="rfm_segment in ('potential_loyalists', 'promising', 'need_attention')"
                                        decoration-danger="rfm_segment in ('at_risk', 'cannot_lose_them', 'hibernating', 'lost')" />
                                    <field name="rfm_score" />
                                    <field name="recency_score" />
                                    <field name="frequency_score" />
                                    <field name="monetary_score" />
                                </group>
                                <group name="rfm_data" string="Purchase Data">
                                    <field name="days_since_last_purchase" />
                                    <field name="purchase_count" />
                                    <field name="total_spent" />
                                </group>
                            </group>
                            <group name="rfm_help">
                                <div class="alert alert-info" role="alert">
                                    <strong>Customer Value Analysis:</strong><br />
                                    This shows how valuable this customer is to your business based on their purchase behavior.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>Recency:</strong> How recently they made their last purchase (more recent = better)</li>
                                        <li><strong>Frequency:</strong> How often they buy from you (more frequent = better)</li>
                                        <li><strong>Monetary:</strong> How much they typically spend (higher spending = better)</li>
                                    </ul>
                                    <strong>Data sources:</strong> All customer purchase orders and payment records<br /><br />
                                    <strong>Customer segments:</strong> Champions (your best customers), Loyal Customers (regular buyers), At Risk (might stop buying), Lost (need to win back)
                                    <br /><br />
                                    <strong>Use this to:</strong> Identify your most valuable customers for VIP treatment and find at-risk customers who need special attention
                                </div>
                            </group>
                        </page>

                        <!-- Engagement Analytics Sub-tab -->
                        <page name="engagement_analytics" string="Engagement"
                            invisible="not customer_rank or not metrics_engagement_enabled">
                            <group name="engagement_overview">
                                <group name="engagement_scores" string="Engagement Scores">
                                    <field name="engagement_level" widget="badge"
                                        decoration-success="engagement_level == 'very_high'"
                                        decoration-info="engagement_level == 'high'"
                                        decoration-warning="engagement_level == 'medium'"
                                        decoration-danger="engagement_level in ('low', 'very_low')" />
                                    <field name="overall_engagement_score" />
                                    <field name="email_engagement_score" />
                                    <field name="website_engagement_score" />
                                    <field name="whatsapp_engagement_score" />
                                </group>
                                <group name="journey_multichannel"
                                    string="Journey &amp; Multi-Channel">
                                    <field name="customer_journey_stage" widget="badge"
                                        decoration-success="customer_journey_stage in ('advocacy', 'loyalty')"
                                        decoration-info="customer_journey_stage == 'purchase'"
                                        decoration-warning="customer_journey_stage in ('consideration', 'awareness')"
                                        decoration-danger="customer_journey_stage == 'dormant'" />
                                    <field name="multichannel_touchpoints" />
                                    <field name="preferred_channel" />
                                    <field name="multichannel_consistency_score" />
                                </group>
                            </group>
                            <group name="engagement_help">
                                <div class="alert alert-info" role="alert">
                                    <strong>Customer Engagement Insights:</strong><br />
                                    This shows how actively this customer interacts with your business across different channels.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>Overall Engagement:</strong> Combined activity score across email, website, and WhatsApp (0-100)</li>
                                        <li><strong>Journey Stage:</strong> Where they are in their relationship with your business (from new prospect to loyal advocate)</li>
                                        <li><strong>Multi-Channel Usage:</strong> How many different ways they interact with you (email, phone, website, WhatsApp)</li>
                                        <li><strong>Preferred Channel:</strong> Their favorite way to communicate with your business</li>
                                    </ul>
                                    <strong>Data sources:</strong> Email opens/clicks, website visits, WhatsApp responses, phone calls, and purchase history over the last 90 days<br /><br />
                                    <strong>Use this to:</strong> Choose the best communication channel for each customer and identify highly engaged customers for special offers
                                </div>
                            </group>
                        </page>

                        <!-- Churn Prediction Sub-tab -->
                        <page name="churn_prediction" string="Churn Risk"
                            invisible="not customer_rank or not metrics_churn_enabled">
                            <group name="churn_overview">
                                <group name="churn_scores" string="Churn Risk Assessment">
                                    <field name="churn_risk_level" widget="badge"
                                        decoration-success="churn_risk_level in ('very_low', 'low')"
                                        decoration-warning="churn_risk_level == 'medium'"
                                        decoration-danger="churn_risk_level in ('high', 'very_high')" />
                                    <field name="churn_risk_score" />
                                </group>
                                <group name="churn_factors" string="Contributing Factors">
                                    <field name="rfm_segment" readonly="1" />
                                    <field name="days_since_last_purchase" readonly="1" />
                                    <field name="overall_engagement_score" readonly="1" />
                                    <field name="customer_journey_stage" readonly="1" />
                                </group>
                            </group>
                            <group name="churn_help">
                                <div class="alert alert-warning" role="alert">
                                    <strong>Customer Retention Risk:</strong><br />
                                    This predicts whether this customer might stop buying from you soon, so you can take action to keep them.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>Risk Score:</strong> Likelihood they'll stop being a customer in the next 90 days (0-100)</li>
                                        <li><strong>Warning Signs:</strong> Declining purchase frequency, reduced engagement with emails/messages, longer gaps between orders</li>
                                        <li><strong>Contributing Factors:</strong> Recent purchase behavior, email/message engagement, overall activity patterns</li>
                                    </ul>
                                    <strong>Data sources:</strong> Purchase history, email engagement, WhatsApp responses, website activity, and customer lifecycle stage<br /><br />
                                    <strong>Use this to:</strong> Identify customers who need immediate attention with special offers, personal outreach, or loyalty programs to prevent them from leaving
                                </div>
                            </group>
                        </page>

                        <!-- Values-Driven Propensity Sub-tab -->
                        <page name="values_propensity" string="Values &amp; Preferences"
                            invisible="not customer_rank or not metrics_values_enabled">
                            <group name="values_overview">
                                <group name="values_scores" string="Purchase Propensity">
                                    <field name="sustainability_preference_score" />
                                    <field name="premium_product_propensity" />
                                    <field name="social_responsibility_score" />
                                </group>
                            </group>
                            <group name="values_help">
                                <div class="alert alert-info" role="alert">
                                    <strong>Customer Values &amp; Preferences:</strong><br />
                                    This shows what this customer cares about when making purchases, helping you recommend the right products.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>Eco-Friendly Score:</strong> How much they prefer environmentally-friendly products (0-100)</li>
                                        <li><strong>Premium Propensity:</strong> Their willingness to pay more for higher-quality products (0-100)</li>
                                        <li><strong>Social Responsibility:</strong> How much they prefer brands that support social causes (0-100)</li>
                                    </ul>
                                    <strong>Data sources:</strong> Analysis of their purchase history looking for eco-friendly, premium, and socially responsible products<br /><br />
                                    <strong>Use this to:</strong> Recommend products that match their values, create targeted marketing campaigns, and personalize product suggestions
                                </div>
                            </group>
                        </page>

                        <!-- Social Commerce Sub-tab -->
                        <page name="social_commerce" string="Social Commerce"
                            invisible="not customer_rank or not metrics_social_enabled">
                            <group name="social_overview">
                                <group name="social_sources" string="Social Media Sources">
                                    <field name="social_media_source" widget="badge"
                                        decoration-success="social_media_source != 'none'"
                                        decoration-muted="social_media_source == 'none'" />
                                    <field name="social_referral_count" />
                                    <field name="social_engagement_score" />
                                    <field name="social_conversion_rate" />
                                </group>
                            </group>
                            <group name="social_help">
                                <div class="alert alert-info" role="alert">
                                    <strong>Social Media Behavior:</strong><br />
                                    This shows how this customer discovers and buys from you through social media platforms.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>Social Media Source:</strong> Which social platform (Facebook, Instagram, TikTok, etc.) brings them to your store</li>
                                        <li><strong>Social Referral Count:</strong> How many times they've bought after clicking from social media</li>
                                        <li><strong>Social Engagement Score:</strong> How actively they interact with your social content (0-100)</li>
                                        <li><strong>Social Conversion Rate:</strong> How often their social media visits turn into purchases (0-100)</li>
                                    </ul>
                                    <strong>Data sources:</strong> Order source tracking, UTM parameters, referral URLs, and social media campaign data<br /><br />
                                    <strong>Use this to:</strong> Focus your social media marketing on the platforms where this customer is most active and likely to buy
                                </div>
                            </group>
                        </page>

                        <!-- BNPL & Mobile Commerce Sub-tab -->
                        <page name="bnpl_mobile" string="BNPL &amp; Mobile"
                            invisible="not customer_rank or not (metrics_bnpl_enabled or metrics_mobile_enabled)">
                            <group name="bnpl_mobile_overview">
                                <group name="bnpl_behavior" string="Buy Now Pay Later (BNPL)">
                                    <field name="bnpl_usage_frequency" widget="badge"
                                        decoration-success="bnpl_usage_frequency in ('frequently', 'always')"
                                        decoration-warning="bnpl_usage_frequency in ('sometimes', 'rarely')"
                                        decoration-muted="bnpl_usage_frequency == 'never'" />
                                    <field name="bnpl_preference_score" />
                                </group>
                                <group name="mobile_behavior" string="Mobile Commerce">
                                    <field name="mobile_device_preference" widget="badge"
                                        decoration-info="mobile_device_preference == 'smartphone'"
                                        decoration-success="mobile_device_preference == 'tablet'"
                                        decoration-warning="mobile_device_preference == 'desktop'"
                                        decoration-muted="mobile_device_preference == 'mixed'" />
                                    <field name="mobile_commerce_score" />
                                    <field name="mobile_conversion_rate" />
                                </group>
                            </group>
                            <group name="order_values">
                                <group name="mobile_orders" string="Mobile Orders">
                                    <field name="average_order_value_mobile" />
                                </group>
                                <group name="desktop_orders" string="Desktop Orders">
                                    <field name="average_order_value_desktop" />
                                </group>
                            </group>
                            <group name="bnpl_mobile_help">
                                <div class="alert alert-info" role="alert">
                                    <strong>Payment &amp; Shopping Preferences:</strong><br />
                                    This shows how this customer prefers to pay and what devices they use for shopping.<br /><br />
                                    <strong>What we analyze:</strong>
                                    <ul>
                                        <li><strong>BNPL Usage:</strong> How often they use Buy Now Pay Later services like Klarna, Afterpay, or installment plans</li>
                                        <li><strong>Mobile Device Preference:</strong> Whether they prefer shopping on smartphone, tablet, or desktop computer</li>
                                        <li><strong>Mobile Commerce Score:</strong> How much they prefer mobile shopping vs desktop (0-100)</li>
                                        <li><strong>Average Order Values:</strong> How much they typically spend when shopping on different devices</li>
                                    </ul>
                                    <strong>Data sources:</strong> Payment method analysis, device detection from orders, shopping session data, and purchase timing patterns<br /><br />
                                    <strong>Use this to:</strong> Optimize your mobile website, offer the right payment options, and time your marketing for when they're most likely to shop
                                </div>
                            </group>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Partner List View - Add Advanced Analytics columns -->
    <record id="view_partner_list_advanced_analytics" model="ir.ui.view">
        <field name="name">res.partner.list.advanced.analytics</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree" />
        <field name="arch" type="xml">
            <field name="vat" position="after">
                <!-- Configuration visibility fields (invisible, used for conditional visibility) -->
                <field name="metrics_engagement_enabled" invisible="1"/>
                <field name="metrics_churn_enabled" invisible="1"/>
                <field name="metrics_journey_enabled" invisible="1"/>
                <field name="metrics_values_enabled" invisible="1"/>
                <field name="metrics_social_enabled" invisible="1"/>
                <field name="metrics_bnpl_enabled" invisible="1"/>
                <field name="metrics_mobile_enabled" invisible="1"/>
                <field name="metrics_multichannel_enabled" invisible="1"/>
                
                <!-- Demographics -->
                <field name="date_of_birth" optional="hide" />
                <field name="age" optional="hide" />

                <!-- RFM Analysis -->
                <field name="rfm_segment" optional="hide" widget="badge"
                    decoration-success="rfm_segment in ('champions', 'loyal_customers')"
                    decoration-warning="rfm_segment in ('potential_loyalists', 'promising', 'need_attention')"
                    decoration-danger="rfm_segment in ('at_risk', 'cannot_lose_them', 'hibernating', 'lost')" />
                <field name="rfm_score" optional="hide" />
                <field name="days_since_last_purchase" optional="hide" />
                <field name="purchase_count" optional="hide" />
                <field name="total_spent" optional="hide" />

                <!-- Engagement Analytics -->
                <field name="engagement_level" optional="hide" widget="badge"
                    invisible="not metrics_engagement_enabled"
                    decoration-success="engagement_level == 'very_high'"
                    decoration-info="engagement_level == 'high'"
                    decoration-warning="engagement_level == 'medium'"
                    decoration-danger="engagement_level in ('low', 'very_low')" />
                <field name="overall_engagement_score" optional="hide" invisible="not metrics_engagement_enabled" />
                <field name="customer_journey_stage" optional="hide" widget="badge"
                    invisible="not metrics_journey_enabled"
                    decoration-success="customer_journey_stage in ('advocacy', 'loyalty')"
                    decoration-info="customer_journey_stage == 'purchase'"
                    decoration-warning="customer_journey_stage in ('consideration', 'awareness')"
                    decoration-danger="customer_journey_stage == 'dormant'" />
                <field name="preferred_channel" optional="hide" invisible="not metrics_multichannel_enabled" />
                <field name="multichannel_touchpoints" optional="hide" invisible="not metrics_multichannel_enabled" />

                <!-- Churn Prediction -->
                <field name="churn_risk_level" optional="hide" widget="badge"
                    invisible="not metrics_churn_enabled"
                    decoration-success="churn_risk_level in ('very_low', 'low')"
                    decoration-warning="churn_risk_level == 'medium'"
                    decoration-danger="churn_risk_level in ('high', 'very_high')" />
                <field name="churn_risk_score" optional="hide" invisible="not metrics_churn_enabled" />

                <!-- Values-Driven Propensity -->
                <field name="sustainability_preference_score" optional="hide" invisible="not metrics_values_enabled" />
                <field name="premium_product_propensity" optional="hide" invisible="not metrics_values_enabled" />
                <field name="social_responsibility_score" optional="hide" invisible="not metrics_values_enabled" />

                <!-- Social Commerce -->
                <field name="social_media_source" optional="hide" widget="badge"
                    invisible="not metrics_social_enabled"
                    decoration-success="social_media_source != 'none'"
                    decoration-muted="social_media_source == 'none'" />
                <field name="social_referral_count" optional="hide" invisible="not metrics_social_enabled" />
                <field name="social_engagement_score" optional="hide" invisible="not metrics_social_enabled" />
                <field name="social_conversion_rate" optional="hide" invisible="not metrics_social_enabled" />

                <!-- BNPL & Mobile Commerce -->
                <field name="bnpl_usage_frequency" optional="hide" widget="badge"
                    invisible="not metrics_bnpl_enabled"
                    decoration-success="bnpl_usage_frequency in ('frequently', 'always')"
                    decoration-warning="bnpl_usage_frequency in ('sometimes', 'rarely')"
                    decoration-muted="bnpl_usage_frequency == 'never'" />
                <field name="bnpl_preference_score" optional="hide" invisible="not metrics_bnpl_enabled" />
                <field name="mobile_device_preference" optional="hide" widget="badge"
                    invisible="not metrics_mobile_enabled"
                    decoration-info="mobile_device_preference == 'smartphone'"
                    decoration-success="mobile_device_preference == 'tablet'"
                    decoration-warning="mobile_device_preference == 'desktop'"
                    decoration-muted="mobile_device_preference == 'mixed'" />
                <field name="mobile_commerce_score" optional="hide" invisible="not metrics_mobile_enabled" />
                <field name="mobile_conversion_rate" optional="hide" invisible="not metrics_mobile_enabled" />
            </field>
        </field>
    </record>

</odoo>