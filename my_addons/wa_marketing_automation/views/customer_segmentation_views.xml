<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wa_marketing_automation_customer_segmentation_action" model="ir.actions.act_window">
        <field name="name">Customer Segmentation</field>
        <field name="res_model">wa_marketing_automation.customer_segmentation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Segment your customers to create targeted campaigns.
            </p>
        </field>
    </record>

    <record id="wa_marketing_automation_customer_segmentation_list_view" model="ir.ui.view">
        <field name="name">wa_marketing_automation.customer_segmentation.list</field>
        <field name="model">wa_marketing_automation.customer_segmentation</field>
        <field name="arch" type="xml">
            <list string="Customer Segmentation">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="wa_marketing_automation_customer_segmentation_form_view" model="ir.ui.view">
        <field name="name">wa_marketing_automation.customer_segmentation.form</field>
        <field name="model">wa_marketing_automation.customer_segmentation</field>
        <field name="arch" type="xml">
            <form string="Customer Segmentation">
                <sheet>
                    <field name="name" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>