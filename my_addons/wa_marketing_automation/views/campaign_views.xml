<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wa_marketing_automation_campaign_action" model="ir.actions.act_window">
        <field name="name">Campaign</field>
        <field name="res_model">wa_marketing_automation.campaign</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Campaign to start your WhatsApp marketing automation journey.
            </p>
        </field>
    </record>

    <record id="wa_marketing_automation_campaign_list_view" model="ir.ui.view">
        <field name="name">wa_marketing_automation.campaign.list</field>
        <field name="model">wa_marketing_automation.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaign">
                <field name="name" />
            </list>
        </field>
    </record>


    <record id="wa_marketing_automation_campaign_form_view" model="ir.ui.view">
        <field name="name">wa_marketing_automation.campaign.form</field>
        <field name="model">wa_marketing_automation.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <sheet>
                    <field name="name" />
                </sheet>
            </form>
        </field>
    </record>
</odoo>