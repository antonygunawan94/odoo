<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main Performance Analytics Pivot View -->
        <record id="performance_analytics_report_pivot" model="ir.ui.view">
            <field name="name">Performance Analytics Report - Pivot</field>
            <field name="model">wa_marketing_automation.performance_analytics_report</field>
            <field name="arch" type="xml">
                <pivot string="Performance Analytics Dashboard"
                    disable_linking="True"
                    display_quantity="1">

                    <!-- Default: DAYA BELI View (A-H × PRODUK/JASA) -->
                    <field name="spending_tier_display" type="row" />
                    <field name="category_name" type="col" />

                    <!-- All Available Dimensions -->
                    <field name="spending_tier_id" string="Spending Tier Config" context="{'show_spending_range': True}" />
                    <field name="spending_tier_name" string="Spending Tier Name" />
                    <field name="spending_tier_display" string="Spending Tier (with Range)" />
                    <field name="customer_age_group" string="Age Group" />
                    <field name="product_type" string="Product Type" />
                    <field name="product_category_id" string="Product Category" />
                    <field name="customer_country_id" string="Country" />
                    <field name="customer_state_id" string="State" />

                    <!-- Customer Acquisition & Segmentation -->
                    <field name="customer_acquisition_source_name" string="Acquisition Source" />
                    <field name="customer_type" string="Customer Type (New/Existing)" />

                    <!-- Sales Dimensions -->
                    <field name="salesperson_id" string="Salesperson" />
                    <field name="sales_team_id" string="Sales Team" />
                    <field name="sales_source_name" string="Sales Source" />
                    <field name="order_month" string="Month" />
                    <field name="order_quarter" string="Quarter" />
                    <field name="order_year" string="Year" />

                    <!-- Measures -->
                    <field name="quantity_ordered" type="measure" />
                    <field name="revenue" type="measure" />
                    <field name="avg_order_value" type="measure" />
                    <field name="order_count" type="measure" />
                    <field name="customer_count" type="measure" />
                </pivot>
            </field>
        </record>

        <!-- Graph View -->
        <record id="performance_analytics_report_graph" model="ir.ui.view">
            <field name="name">Performance Analytics Report - Graph</field>
            <field name="model">wa_marketing_automation.performance_analytics_report</field>
            <field name="arch" type="xml">
                <graph string="Performance Analytics" type="bar" stacked="True">
                    <field name="spending_tier_name" />
                    <field name="category_name" type="col" />
                    <field name="revenue" type="measure" />
                </graph>
            </field>
        </record>

        <!-- List View (for drill-down) -->
        <record id="performance_analytics_report_list" model="ir.ui.view">
            <field name="name">Performance Analytics Report - List</field>
            <field name="model">wa_marketing_automation.performance_analytics_report</field>
            <field name="arch" type="xml">
                <list string="Performance Analytics Details" create="false" edit="false"
                    delete="false">
                    <field name="order_date" optional="show" />
                    <field name="order_id" optional="show" />
                    <field name="customer_name" optional="show" />
                    <field name="product_name" optional="show" />
                    <field name="spending_tier_id" optional="show" />
                    <field name="spending_tier_name" optional="show" />
                    <field name="spending_tier_display" optional="show" />
                    <field name="category_name" optional="show" />
                    <field name="customer_acquisition_source_name" optional="show" />
                    <field name="sales_source_name" optional="show" />
                    <field name="quantity_ordered" optional="show" />
                    <field name="revenue" widget="monetary" optional="show" />
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="performance_analytics_report_search" model="ir.ui.view">
            <field name="name">Performance Analytics Report - Search</field>
            <field name="model">wa_marketing_automation.performance_analytics_report</field>
            <field name="arch" type="xml">
                <search string="Performance Analytics">
                    <!-- Quick Filters -->
                    <field name="customer_name" string="Customer" />
                    <field name="product_name" string="Product" />
                    <field name="spending_tier_name" string="Spending Tier" />
                    <field name="category_name" string="Category" />

                    <!-- Separator -->
                    <separator />

                    <!-- Group By Options -->
                    <filter string="By Spending Tier" name="group_spending_tier"
                        context="{'group_by': 'spending_tier_name'}" />
                    <filter string="By Product Category" name="group_category"
                        context="{'group_by': 'category_name'}" />
                    <filter string="By Customer Type" name="group_customer_type"
                        context="{'group_by': 'customer_type'}" />
                    <filter string="By Acquisition Source" name="group_acquisition"
                        context="{'group_by': 'customer_acquisition_source_name'}" />
                    <filter string="By Sales Source" name="group_sales_source"
                        context="{'group_by': 'sales_source_name'}" />

                    <!-- Separator -->
                    <separator />

                    <!-- Date Filters -->
                    <filter string="This Year" name="filter_this_year"
                        domain="[('order_year', '=', context_today().year)]" />
                    <filter string="Last Year" name="filter_last_year"
                        domain="[('order_year', '=', context_today().year - 1)]" />
                    <filter string="This Month" name="filter_this_month"
                        domain="[('order_month', '=', time.strftime('%Y-%m'))]" />

                    <!-- Group By Date -->
                    <group expand="0" string="Group By">
                        <filter string="Order Date" name="group_date"
                            context="{'group_by': 'order_date'}" />
                        <filter string="Month" name="group_month"
                            context="{'group_by': 'order_month'}" />
                        <filter string="Quarter" name="group_quarter"
                            context="{'group_by': 'order_quarter'}" />
                        <filter string="Year" name="group_year"
                            context="{'group_by': 'order_year'}" />
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Window -->
        <record id="action_performance_analytics_report" model="ir.actions.act_window">
            <field name="name">Performance Analytics Report</field>
            <field name="res_model">wa_marketing_automation.performance_analytics_report</field>
            <field name="view_mode">pivot,graph,list</field>
            <field name="view_id" ref="performance_analytics_report_pivot" />
            <field name="context">{
                'search_default_group_spending_tier': 1,
                'search_default_filter_this_year': 1
                }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Welcome to Performance Analytics!
                </p>
                <p>
                    This powerful dashboard lets you analyze sales performance from multiple angles:
                </p>
                <ul>
                    <li><strong>Spending Tiers (A-H):</strong> Customer categorization by spending
                        amounts</li>
                    <li><strong>Product Categories:</strong> Performance by product/service types</li>
                    <li><strong>Customer Acquisition:</strong> Track which channels bring the best
                        customers</li>
                    <li><strong>Sales Sources:</strong> Analyze business classification performance</li>
                </ul>
                <p>
                    <strong>How to use:</strong> Drag dimensions between rows and columns to create
                    custom views. Click on any data point to drill down for detailed analysis. </p>
            </field>
        </record>

        <!-- Shortcut Action for DAYA BELI Analysis -->
        <record id="action_daya_beli_analysis" model="ir.actions.act_window">
            <field name="name">DAYA BELI Analysis (A-H × Category)</field>
            <field name="res_model">wa_marketing_automation.performance_analytics_report</field>
            <field name="view_mode">pivot,graph</field>
            <field name="view_id" ref="performance_analytics_report_pivot" />
            <field name="context">{
                'pivot_row_groupby': ['spending_tier_name'],
                'pivot_column_groupby': ['category_name'],
                'pivot_measures': ['revenue', 'order_count'],
                'search_default_filter_this_year': 1
                }</field>
        </record>

        <!-- Shortcut Action for Age Group vs Acquisition Source -->
        <record id="action_age_acquisition_analysis" model="ir.actions.act_window">
            <field name="name">Age Group vs Acquisition Source Analysis</field>
            <field name="res_model">wa_marketing_automation.performance_analytics_report</field>
            <field name="view_mode">pivot,graph</field>
            <field name="view_id" ref="performance_analytics_report_pivot" />
            <field name="context">{
                'pivot_row_groupby': ['customer_age_group'],
                'pivot_column_groupby': ['customer_acquisition_source_name'],
                'pivot_measures': ['customer_count', 'revenue'],
                'search_default_filter_this_year': 1
                }</field>
        </record>

        <!-- Shortcut Action for Customer Type vs Acquisition Source -->
        <record id="action_customer_type_analysis" model="ir.actions.act_window">
            <field name="name">Customer Segmentation Analysis</field>
            <field name="res_model">wa_marketing_automation.performance_analytics_report</field>
            <field name="view_mode">pivot,graph</field>
            <field name="view_id" ref="performance_analytics_report_pivot" />
            <field name="context">{
                'pivot_row_groupby': ['customer_type'],
                'pivot_column_groupby': ['customer_acquisition_source_name'],
                'pivot_measures': ['customer_count', 'revenue'],
                'search_default_filter_this_year': 1
                }</field>
        </record>

    </data>
</odoo>