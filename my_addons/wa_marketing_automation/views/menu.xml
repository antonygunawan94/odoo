<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="wa_marketing_automation_menu_base"
        name="WhatsApp Marketing Automation"
        web_icon="wa_marketing_automation,static/description/icon.png"
    />

    <!-- Campaigns Menu (now a parent menu) -->
    <menuitem id="wa_marketing_automation_menu_campaign"
        name="Campaigns"
        parent="wa_marketing_automation_menu_base"
        sequence="10"
    />
    
    <menuitem id="wa_marketing_automation_menu_campaign_list"
        name="Campaign Management"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_campaign_action"
        sequence="10"
    />

    <menuitem id="wa_marketing_automation_menu_customer_segmentation"
        name="Customer Segmentations"
        parent="wa_marketing_automation_menu_base"
        action="wa_marketing_automation.wa_marketing_automation_customer_segmentation_action"
        sequence="20"
    />

    <menuitem id="wa_marketing_automation_menu_whatsapp_api_log"
        name="WhatsApp API Logs"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_whatsapp_api_log_action"
        sequence="20"
    />

    <!-- Reports Menu -->
    <menuitem id="wa_marketing_automation_menu_reports"
        name="Reports"
        parent="wa_marketing_automation_menu_base"
        sequence="40"
    />

    <menuitem id="wa_marketing_automation_menu_customer_demographics_report"
        name="Customer Demographics Analysis"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.action_customer_demographics_report"
        sequence="10"
    />

    <menuitem id="wa_marketing_automation_menu_age_distribution"
        name="Age Distribution Analysis"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.action_customer_age_distribution"
        sequence="20"
    />

    <menuitem id="wa_marketing_automation_menu_rfm_analysis"
        name="RFM Analysis"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.action_customer_rfm_analysis"
        sequence="30"
    />

    <menuitem id="wa_marketing_automation_menu_churn_risk"
        name="Churn Risk Analysis"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.action_customer_churn_risk"
        sequence="40"
    />

    <menuitem id="wa_marketing_automation_menu_cohort_analysis"
        name="Cohort Analysis"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.action_cohort_analysis_report"
        sequence="50"
    />

    <menuitem id="wa_marketing_automation_menu_scheduled_actions"
        name="Scheduled Actions"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_scheduled_actions_action"
        sequence="30"
    />

    <!-- Configuration Menu - Opens Settings > General Settings > WhatsApp Marketing Automation -->
    <menuitem id="wa_marketing_automation_menu_config"
        name="Configuration"
        parent="wa_marketing_automation_menu_base"
        action="wa_marketing_automation.action_wa_marketing_config"
        sequence="100"
    />

    <menuitem id="wa_marketing_automation_menu_advanced_filter"
        name="Advanced Analytics Filter"
        parent="wa_marketing_automation_menu_base"
        action="wa_marketing_automation.action_advanced_analytics_filter"
        sequence="30"
    />

</odoo>