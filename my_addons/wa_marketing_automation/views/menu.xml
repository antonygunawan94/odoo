<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="wa_marketing_automation_menu_base"
        name="WhatsApp Marketing Automation"
        web_icon="wa_marketing_automation,static/description/icon.png"
    />

    <!-- Campaigns Menu (now a parent menu) -->
    <menuitem id="wa_marketing_automation_menu_campaign"
        name="Campaigns"
        parent="wa_marketing_automation_menu_base"
        sequence="10"
    />
    
    <menuitem id="wa_marketing_automation_menu_campaign_list"
        name="Campaign Management"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_campaign_action"
        sequence="10"
    />

    <menuitem id="wa_marketing_automation_menu_customer_segmentation"
        name="Customer Segmentations"
        parent="wa_marketing_automation_menu_base"
        action="wa_marketing_automation.wa_marketing_automation_customer_segmentation_action"
        sequence="20"
    />


    <!-- Configuration Submenu -->
    <menuitem id="wa_marketing_automation_menu_configuration"
        name="Configuration"
        parent="wa_marketing_automation_menu_base"
        sequence="90"
    />

    <menuitem id="wa_marketing_automation_menu_customer_spending_tier_config"
        name="Customer Spending Tiers"
        parent="wa_marketing_automation_menu_configuration"
        action="wa_marketing_automation.action_customer_spending_tier_config"
        sequence="20"
        groups="base.group_user"
    />

    <menuitem id="wa_marketing_automation_menu_customer_age_group_config"
        name="Customer Age Groups"
        parent="wa_marketing_automation_menu_configuration"
        action="wa_marketing_automation.action_customer_age_group_config"
        sequence="30"
        groups="base.group_user"
    />

    <menuitem id="wa_marketing_automation_menu_customer_acquisition_source"
        name="Customer Acquisition Sources"
        parent="wa_marketing_automation_menu_configuration"
        action="wa_marketing_automation.action_customer_acquisition_source"
        sequence="40"
        groups="base.group_user"
    />


    <menuitem id="wa_marketing_automation_menu_whatsapp_api_log"
        name="WhatsApp API Logs"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_whatsapp_api_log_action"
        sequence="20"
    />

    <!-- Reports Menu -->
    <menuitem id="wa_marketing_automation_menu_reports"
        name="Reports"
        parent="wa_marketing_automation_menu_base"
        sequence="40"
    />

    <menuitem id="wa_marketing_automation_menu_performance_analytics"
        name="Performance Analytics Report"
        parent="wa_marketing_automation_menu_reports"
        action="wa_marketing_automation.performance_analytics_report_action"
        sequence="10"
        groups="base.group_user"
    />


    <menuitem id="wa_marketing_automation_menu_scheduled_actions"
        name="Scheduled Actions"
        parent="wa_marketing_automation_menu_campaign"
        action="wa_marketing_automation.wa_marketing_automation_scheduled_actions_action"
        sequence="30"
    />

    <!-- General Settings - Opens Settings > General Settings > WhatsApp Marketing Automation -->
    <menuitem id="wa_marketing_automation_menu_config"
        name="General Settings"
        parent="wa_marketing_automation_menu_configuration"
        action="wa_marketing_automation.action_wa_marketing_config"
        sequence="10"
    />


</odoo>